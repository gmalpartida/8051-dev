10     REM --- LCD 4-BIT INIT ON PORT 1 (DATA=P1.0-3, RS=P1.4, RW=P1.5, E=P1.6) -
20     FOR D=1 TO 1000 :  NEXT D :  REM POWER-ON DELAY (>15MS)
30    PORT1=0 :  REM START ALL PINS LOW
40     REM --- FORCE 4-BIT MODE (8-BIT MODE RESET PATTERN) ---
50    V=03H :  GOSUB 500 :  REM 1ST ATTEMPT (SEND NIBBLE 3)
60     FOR D=1 TO 100 :  NEXT D :  REM WAIT
70    V=03H :  GOSUB 500 :  REM 2ND ATTEMPT
80    V=03H :  GOSUB 500 :  REM 3RD ATTEMPT
90    V=02H :  GOSUB 500 :  REM SWITCH TO 4-BIT MODE (SEND NIBBLE 2)
100    REM --- FUNCTION SET: 2-LINE MODE ---
110   V=28H :  GOSUB 600 :  REM 4-BIT, 2-LINE, 5X8 FONT
120   V=0CH :  GOSUB 600 :  REM DISPLAY ON, CURSOR OFF
130   V=01H :  GOSUB 600 :  REM CLEAR DISPLAY
140    FOR D=1 TO 200 :  NEXT D :  REM CLEAR NEEDS EXTRA TIME
150   V=06H :  GOSUB 600 :  REM ENTRY MODE: CURSOR INCREMENT
200    REM --- SEND CHARACTER 'H' ---
210   V=48H :  GOSUB 800
240   V=65H: GOSUB 800
260   V=6CH: GOSUB 800
280   V=6CH: GOSUB 800
290   V=6FH: GOSUB 800
320   V=20H :  GOSUB 800
330   V=57H :  GOSUB 800
340   V=6FH :  GOSUB 800
350   V=72H :  GOSUB 800
360   V=6CH :  GOSUB 800
370   V=64H :  GOSUB 800
380   V=21H :  GOSUB 800
400    END 
500    REM --- SUBROUTINE: SEND SINGLE NIBBLE (FOR INIT) ---
510   PORT1=(PORT1.AND.0F0H).OR.(V.AND.0FH)
520   PORT1=PORT1.OR.40H :  REM E = 1 (P1.6 IS 40H)
530   PORT1=PORT1.AND.0BFH :  REM E = 0 (LATCH)
540    FOR I=1 TO 50 :  NEXT I :  REM DELAY
550    RETURN 
600    REM --- SUBROUTINE: SEND FULL BYTE (NIBBLE BY NIBBLE) ---
610    REM SEND UPPER NIBBLE FIRST
620   N=(V/16).AND.0FH :  REM EXTRACT HIGH 4 BITS
630   PORT1=(PORT1.AND.0F0H).OR.N
640   PORT1=PORT1.OR.40H : PORT1=PORT1.AND.0BFH
650    REM SEND LOWER NIBBLE
660   N=V.AND.0FH :  REM EXTRACT LOW 4 BITS
670   PORT1=(PORT1.AND.0F0H).OR.N
680   PORT1=PORT1.OR.40H : PORT1=PORT1.AND.0BFH
690    FOR I=1 TO 50 :  NEXT I :  REM PROCESSING DELAY
700    RETURN 
800   PORT1=PORT1.OR.10H
810    GOSUB 600
820    RETURN 
