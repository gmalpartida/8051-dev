  186:	  015A	78 30		        MOV R0,#CMDLIN          ;address of command line buffer
  187:	  015C	76 00		RDCOM1: MOV @R0,#0              ;always terminate buffer with a 0
  188:	  015E	12 03 73	        CALL CONIN              ;read character
