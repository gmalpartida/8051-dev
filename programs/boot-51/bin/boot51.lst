  359:	  02CA			NEXTB:  ;reads one byte in ASCII-hex representation from
  360:				        ;the UART and returns the binary value in A.
  361:				        ;The checksum in R1 is updated accordingly.
  362:				        ;(In case of error the carry flag is set.)
  363:				        ;NEXTB changes only registers A, B, R1 and R7.
  364:	  02CA	12 03 73	        CALL CONIN      ;read first hex digit
  365:	  02CD	12 03 14	        CALL NIBBLE     ;convert it to 4-bit binary
  366:	  02D0	40 0F		        JC NEXTBR       ;stop, if error
  367:	  02D2	C4		        SWAP A          ;otherwise move it to high order nibble
  368:	  02D3	FF		        MOV R7,A        ;and save it
  369:	  02D4	12 03 73	        CALL CONIN      ;read second hex digit
  370:	  02D7	12 03 14	        CALL NIBBLE     ;convert it to 4-bit binary
  371:	  02DA	40 05		        JC NEXTBR       ;stop, if error
  372:	  02DC	4F		        ORL A,R7        ;join both nibbles
  373:	  02DD	C9		        XCH A,R1        ;add the whole byte
  374:	  02DE	29		        ADD A,R1        ;to the checksum
  375:	  02DF	C9		        XCH A,R1
  376:	  02E0	C3		        CLR C           ;no error
  377:	  02E1	22		NEXTBR: RET             ;finished, carry set if error
  378:
  379:	  02E2			EIN16:  ;starting from the current line position R0, a 16-bit
  380:				        ;hex number is read from the command line buffer, and
  381:				        ;converted to a binary number which is returned in R4/R5.
  382:				        ;If no error was detected A=0 on return, A<>0 otherwise.
  383:	  02E2	7E 04		        MOV R6,#4       ;up to 4 digits
  384:	  02E4	12 02 EC	        CALL HEX16      ;convert to binary
  385:	  02E7	70 02		        JNZ EIN16F      ;error, if garbage
  386:	  02E9	31 48		        CALL NIXMER     ;check for end of line
  387:	  02EB	22		EIN16F: RET             ;if garbage, error: A<>0
  388:
  389:	  02EC			HEX16:  ;starting from the current line position R0, a 16-bit
  390:				        ;hex number with up to R6 digits is read from the line
  391:				        ;buffer and converted to a binary number which is
  392:				        ;returned in R4/R5.
  393:				        ;If no error was detected A=0 on return, A<>0 otherwise.
  394:	  02EC	E6		        MOV A,@R0       ;read character
