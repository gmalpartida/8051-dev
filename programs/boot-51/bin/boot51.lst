  294:	  025B			UPLOAD: ;reads an Intel-Hex file from the UART and loads
  295:				        ;it to its start address in the external RAM.
  296:				        ;UPLOAD returns the following error codes in A:
  297:				        ;
  298:				        ; A = 0                     hex file loaded correctly
  299:				        ; A = ILLEGAL_HEXDIGIT      illegal hex digit
  300:				        ; A = CHECKSUM_ERROR        checksum error
  301:				        ; A = UNEXPECTED_CHAR       unexpected character
  302:				        ; A = ILLEGAL_RECORDID      illegal record ID
  303:				        ;
  304:				        ;UPLOAD only changes registers A,B,DPTR,R0,R1,R2, and R7.
  305:	  025B	12 03 73	        CALL CONIN         ;read characters
  306:	  025E	B4 3A FA	        CJNE A,#':',UPLOAD ;until a ":" is received
  307:	  0261	79 00		UPLOA0: MOV R1,#0          ;initialize checksum
  308:	  0263	12 02 CA	        CALL NEXTB         ;convert next two characters to a byte
  309:	  0266	40 56		        JC UPLOA4          ;if they are no hex digits, error
  310:	  0268	F8		        MOV R0,A           ;save number of data bytes
  311:	  0269	12 02 CA	        CALL NEXTB         ;record address, HI byte
  312:	  026C	40 50		        JC UPLOA4          ;if no hex digits: error
  313:	  026E	F5 83		        MOV DPH,A          ;save HI byte
  314:	  0270	12 02 CA	        CALL NEXTB         ;record address, LO byte
  315:	  0273	40 49		        JC UPLOA4          ;if no hex digits: error
  316:	  0275	F5 82		        MOV DPL,A          ;save LO byte
  317:	  0277	12 02 CA	        CALL NEXTB         ;record ID
  318:	  027A	40 42		        JC UPLOA4          ;if no hex digits: error
  319:	  027C	FA		        MOV R2,A           ;save record ID
  320:	  027D	E8		        MOV A,R0           ;number of data bytes
  321:	  027E	60 09		        JZ UPLOA2          ;if 0, probably EOF record
  322:	  0280	12 02 CA	UPLOA1: CALL NEXTB         ;next data byte
  323:	  0283	40 39		        JC UPLOA4          ;if no hex digits: error
  324:	  0285	F0		        MOVX @DPTR,A       ;load it into external RAM
  325:	  0286	A3		        INC DPTR           ;next byte
  326:	  0287	D8 F7		        DJNZ R0,UPLOA1     ;until all data bytes are loaded
  327:	  0289	12 02 CA	UPLOA2: CALL NEXTB         ;checksum
  328:	  028C	40 30		        JC UPLOA4          ;if no hex digits: error
  329:	  028E	E9		        MOV A,R1           ;checksum = 0 ?
  330:	  028F	70 30		        JNZ UPLOA5         ;if no, checksum error
  331:	  0291	EA		        MOV A,R2           ;record ID
  332:	  0292	70 22		        JNZ UPLOA3         ;if <> 0, probably EOF record
  333:	  0294	12 03 73	        CALL CONIN         ;read character
  334:	  0297	B4 0D 17	        CJNE A,#CR,UPLOAU  ;if no CR, may be UNIX style ASCII file
  335:	  029A	12 03 73	        CALL CONIN         ;read next character
  336:	  029D	B4 0A 03	        CJNE A,#LF,UPLOA9  ;if no LF, may be ASCII upload with LF stripped
  337:	  02A0	12 03 73	UPLOA8: CALL CONIN         ;read next character
  338:	  02A3	B4 3A 1E	UPLOA9: CJNE A,#':',UPLOA6 ;if no ":", unexpected character
  339:	  02A6	C0 E0				PUSH 0E0H
  340:	  02A8	74 2E				MOV A, #'.'
  341:	  02AA	12 03 6B			CALL CONOUT
