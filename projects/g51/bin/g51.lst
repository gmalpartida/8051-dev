  373: 1			; --- String Compare Utility ---
  374: 1  0865			STRCMP:
  375: 1			    ; Compares RAM string at R0 with CODE string at DPTR
  376: 1			    ; Returns A=0 if match, A=1 if no match
  377: 1  0865			STRCMP_LOOP:
  378: 1  0865	E4		    CLR A
  379: 1  0866	93		    MOVC A, @A+DPTR     ; Get char from CODE
  380: 1  0867	F5 F0		    MOV B, A            ; Store in B
  381: 1  0869	E6		    MOV A, @R0          ; Get char from RAM
  382: 1  086A	B5 F0 08	    CJNE A, B, NO_MATCH ; Compare
  383: 1  086D	60 04		    JZ MATCH            ; If both are 0, they match
  384: 1  086F	08		    INC R0
  385: 1  0870	A3		    INC DPTR
  386: 1  0871	80 F2		    SJMP STRCMP_LOOP
  387: 1  0873			MATCH:
  388: 1  0873	E4		    CLR A               ; Return 0
  389: 1  0874	22		    RET
  390: 1  0875			NO_MATCH:
  391: 1  0875	74 01		    MOV A, #01H         ; Return 1
  392: 1  0877	22		    RET

