                                     46 ; --> r6,r7: address of memory buffer
                                     47 ; --> r5: 	character for which to search
                                     48 ; --> r4:	how many bytes at which to look
                                     49 ; <-- r6,r7: address at which character was found, otherwise NULL
                                     50 ; <-- c: clear if found, otherwise set
      000024                         51 memchr_c:
      000024 8E 83            [24]   52 	mov dph, r6
      000026 8F 82            [24]   53 	mov dpl, r7
      000028                         54 memchr_loop_c:
      000028 E4               [12]   55 	clr a
      000029 93               [24]   56 	movc a, @a + dptr
      00002A C3               [12]   57 	clr c
