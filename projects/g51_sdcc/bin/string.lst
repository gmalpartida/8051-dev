                                      4 .area CSEG (CODE)
                                      5 
                                      6 ; compares two null terminated strings
                                      7 ; --> dptr		string in cseg
                                      8 ; --> R7:R6		string in xseg
                                      9 ; <-- C			set if equal, otherwise clear
      000000                         10 strcmp:
      000000                         11 strcmp_loop:
      000000 E4               [12]   12 	clr a
      000001 93               [24]   13 	movc a, @a + dptr				; read char
      000002 F5 F0            [12]   14 	mov b, a						; save char read
      000004 C0 82            [24]   15 	push dpl						; backup address of code segment string
      000006 C0 83            [24]   16 	push dph
      000008 8F 83            [24]   17 	mov dph, R7						; load address of xseg string
      00000A 8E 82            [24]   18 	mov dpl, R6
      00000C E0               [24]   19 	movx a, @dptr					; read char
      00000D 65 F0            [12]   20 	xrl a, b						; evaluate to zero if equal
      00000F 70 10            [24]   21 	jnz strcmp_no_match				; not zero so no match
      000011 E5 F0            [12]   22 	mov a, b						; check if b is also zero
      000013 60 0F            [24]   23 	jz strcmp_match					; both null char so match, exit
      000015 A3               [24]   24 	inc dptr						; increment R7:R6 pointer
      000016 AF 83            [24]   25 	mov R7, dph						; save in registers
      000018 AE 82            [24]   26 	mov R6, dpl
      00001A D0 83            [24]   27 	pop dph							; restore code segment string
      00001C D0 82            [24]   28 	pop dpl
      00001E A3               [24]   29 	inc dptr						; increment pointer
      00001F 80 DF            [24]   30 	sjmp strcmp_loop				; check next character
      000021                         31 strcmp_no_match:
      000021 C3               [12]   32 	clr c
      000022 80 01            [24]   33     sjmp strcmp_cleanup
      000024                         34 strcmp_match:
      000024 D3               [12]   35 	setb c
      000025                         36 strcmp_cleanup:
      000025 D0 83            [24]   37 	pop dph
      000027 D0 82            [24]   38 	pop dpl
      000029 22               [24]   39 	ret
                                     40 
      00002A                         41 strncmp:
                                     42 				; counter
      00002A                         43 strncmp_loop:
      00002A E4               [12]   44     CLR A
      00002B 93               [24]   45     MOVC A, @A+DPTR     ; Get char from CODE
      00002C F5 F0            [12]   46     MOV B, A            ; Store in B
      00002E E6               [12]   47     MOV A, @R0          ; Get char from RAM
      00002F B5 F0 06         [24]   48     CJNE A, B, strncmp_no_match ; Compare
      000032 08               [12]   49     INC R0
      000033 A3               [24]   50     INC DPTR
      000034 DA F4            [24]   51 	djnz r2, strncmp_loop
                                     52     
      000036                         53 strncmp_match:
      000036 E4               [12]   54     CLR A               ; Return 0
      000037 22               [24]   55     RET
      000038                         56 strncmp_no_match:
      000038 74 01            [12]   57     MOV A, #0x01        ; Return 1
