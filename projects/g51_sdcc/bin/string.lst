                                      4 .area cseg (code)
                                      5 ; --- String Compare Utility ---
      000000                          6 STRCMP:
                                      7     ; Compares RAM string at R0 with CODE string at DPTR
                                      8     ; Returns A=0 if match, A=1 if no match
      000000                          9 STRCMP_LOOP:
      000000 E4               [12]   10     CLR A
      000001 93               [24]   11     MOVC A, @A+DPTR     ; Get char from CODE
      000002 F5 F0            [12]   12     MOV B, A            ; Store in B
      000004 E6               [12]   13     MOV A, @R0          ; Get char from RAM
      000005 B5 F0 08         [24]   14     CJNE A, B, NO_MATCH ; Compare
      000008 60 04            [24]   15     JZ MATCH            ; If both are 0, they match
      00000A 08               [12]   16     INC R0
      00000B A3               [24]   17     INC DPTR
      00000C 80 F2            [24]   18     SJMP STRCMP_LOOP
      00000E                         19 MATCH:
      00000E E4               [12]   20     CLR A               ; Return 0
      00000F 22               [24]   21     RET
      000010                         22 NO_MATCH:
      000010 74 01            [12]   23     MOV A, #0x01         ; Return 1
      000012 22               [24]   24     RET
                                     25 
      000013                         26 strncmp:
                                     27 				; counter
      000013                         28 strncmp_loop:
      000013 E4               [12]   29     CLR A
      000014 93               [24]   30     MOVC A, @A+DPTR     ; Get char from CODE
      000015 F5 F0            [12]   31     MOV B, A            ; Store in B
      000017 E6               [12]   32     MOV A, @R0          ; Get char from RAM
      000018 B5 F0 06         [24]   33     CJNE A, B, strncmp_no_match ; Compare
      00001B 08               [12]   34     INC R0
      00001C A3               [24]   35     INC DPTR
      00001D DA F4            [24]   36 	djnz r2, strncmp_loop
                                     37     
      00001F                         38 strncmp_match:
      00001F E4               [12]   39     CLR A               ; Return 0
      000020 22               [24]   40     RET
      000021                         41 strncmp_no_match:
      000021 74 01            [12]   42     MOV A, #0x01        ; Return 1
      000023 22               [24]   43     RET
                                     44 
