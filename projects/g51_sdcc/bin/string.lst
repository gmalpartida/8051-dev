                                      2 .include "string.inc"
                                      1 .globl STRCMP
                                      2 .globl strncmp
                                      3 
                                      4 ; finds character c in the first n bytes of a memory buffer in program memory
                                      5 ; --> r6,r7: address of memory buffer
                                      6 ; --> r5: 	character for which to search
                                      7 ; --> r4:	how many bytes at which to look
                                      8 ; <-- r6,r7: address at which character was found, otherwise NULL
                                      9 ; <-- c: clear if found, otherwise set
                                     10 .globl memchr_c
                                     11 
                                     12 ; finds character c in the first n bytes of a memory buffer in data memory
                                     13 ; --> r6,r7: address of memory buffer
                                     14 ; --> r5: 	character for which to search
                                     15 ; --> r4:	how many bytes at which to look
                                     16 ; <-- r6,r7: address at which character was found, otherwise NULL
                                     17 .globl memchr
                                     18 
                                     19 ; compares the first n bytes of two blocks of memory, one of which is in program memory
                                     20 ; --> r6, r7: 	address of block of memory in program memory
                                     21 ; --> r4, r5: 	address of block of memory in data memory
                                     22 ; --> r3: 		how many bytes to compare
                                     23 ; <-- r7:		0 if equal, -1 if first block is less than second block, otherwise 1
                                     24 
                                     25 .globl memcmp_c
                                     26 
                                     27 ; copies n bytes from one memory block to another, one of which resides in program memory
                                     28 ; --> r6, r7: address of source memory block in program memory
                                     29 ; --> r4, r5: address of destination memory block in data memory
                                     30 ; --> r3: 	  how many bytes to copy
                                     31 
                                     32 .globl memcpy_c
                                     33 
                                     34 ; initializes a memory block with a specific byte
                                     35 ; --> r6, r7: address of memory block
                                     36 ; --> r5: length of memory block
                                     37 ; --> r4: byte to fill the block
                                     38 
                                     39 .globl memset
                                     40 
                                     41 ; moves a memory block from one location to another
                                     42 ; --> r6, r7: address of source memory block
                                     43 ; --> r4, r5: address of destination memory block
                                     44 ; --> r3: how many bytes to move
                                     45 .globl memcpy
                                     46 
