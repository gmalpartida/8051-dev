      000000                          7 uart_init:
      000000 53 89 0F         [24]    8     anl tmod, #0x0f					; Clear Timer 1 mode bits
      000003 43 89 20         [24]    9     orl tmod, #0x20					; Set Timer 1 to Mode 2 (8-bit auto-reload)
                                     10     
                                     11     ;mov th1, #0xff                 ; 57600 bps at 11.0592 MHz
      000006 75 8D FA         [24]   12 	mov th1, #0xfa					; 19200 bps
      000009 75 8D FD         [24]   13 	mov th1, #0xfd					; 9600 bps
                                     14     
      00000C 43 87 80         [24]   15     orl pcon, #0x80					; Set SMOD to 1 (Doubles the baud rate generation)
                                     16     
      00000F 75 98 50         [24]   17     mov scon, #0x50					; Mode 1 (8-bit UART), ENABLE receiver (REN=1)
      000012 D2 8E            [12]   18     setb tr1                        ; Start Timer 1
                                     19     
                                     20     ;setb ti                        ; set transmitter 'ready'
                                     21 
      000014 74 00            [12]   22 	mov a, #0x00
      000016 90 01 00         [24]   23 	mov dptr, #uart_rx_buffer_head
      000019 F0               [24]   24 	movx @dptr, a
      00001A 90 01 01         [24]   25 	mov dptr,#uart_rx_buffer_tail
      00001D F0               [24]   26 	movx @dptr, a
                                     27 
      00001E 22               [24]   28     ret
