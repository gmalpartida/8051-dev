      00004F                         70 uart_tx_asciz:
      00004F E4               [12]   71 	clr a
      000050 93               [24]   72 	movc a, @a + dptr
      000051 60 05            [24]   73 	jz uart_tx_asciz_exit
      000053 00 45            [12]   74 	acall uart_tx_char
      000055 A3               [24]   75 	inc dptr
      000056 80 F7            [24]   76 	sjmp uart_tx_asciz
      000058                         77 uart_tx_asciz_exit:
      000058 22               [24]   78 	ret
                                     79 
      000059                         80 uart_rx_asciz:
      000059 00 1C            [12]   81 	acall uart_rx_char
      00005B F5 F0            [12]   82 	mov b, a									; make copy of it, next statements destroy char in a
      00005D 60 12            [24]   83 	jz uart_rx_asciz_exit						; if NULL then exit
      00005F 64 0A            [12]   84 	xrl a, #CR
      000061 60 0E            [24]   85 	jz uart_rx_asciz_exit						; if CR then exit
      000063 E5 F0            [12]   86 	mov a, b									; restore copy of char
      000065 64 0D            [12]   87 	xrl a, #LF
      000067 60 08            [24]   88 	jz uart_rx_asciz_exit						; if LF then exit
      000069 E5 F0            [12]   89 	mov a, b
      00006B                         90 uart_rx_asciz_process_char:
      00006B F0               [24]   91 	movx @dptr, a								; not NULL, CR or LF, keep it
      00006C A3               [24]   92 	inc dptr
      00006D 00 45            [12]   93 	acall uart_tx_char							; echo char
      00006F 80 E8            [24]   94 	sjmp uart_rx_asciz
      000071                         95 uart_rx_asciz_exit:
      000071 74 00            [12]   96 	mov a, #0x00								; the last character must be NULL
      000073 F0               [24]   97 	movx @dptr, a
      000074 22               [24]   98 	ret
                                     99 
      000075                        100 uart_rx_asciz2:
                                    101     ; 1. Protect the start boundary using the stack
      000075 C0 82            [24]  102     push dpl                     ; Push low byte of start address
      000077 C0 83            [24]  103     push dph                     ; Push high byte of start address
                                    104 
      000079                        105 uart_rx_loop:
      000079 00 1C            [12]  106     acall uart_rx_char           ; Get char into Acc
      00007B F8               [12]  107     mov r0, a                    ; Save received character to temp R0
                                    108 
                                    109     ; Check for CR
      00007C C3               [12]  110     clr c
      00007D 94 0A            [12]  111     subb a, #CR
      00007F 60 46            [24]  112     jz rx_terminate
ASxxxx Assembler V02.00 + NoICE + SDCC mods  (Intel 8051)               Page 5
Hexadecimal [24-Bits]



                                    113 
                                    114     ; Check for LF
      000081 E8               [12]  115     mov a, r0
      000082 C3               [12]  116     clr c
      000083 94 0D            [12]  117     subb a, #LF
      000085 60 40            [24]  118     jz rx_terminate
                                    119 
                                    120     ; Check for BS (0x08)
      000087 E8               [12]  121     mov a, r0
      000088 C3               [12]  122     clr c
      000089 94 08            [12]  123     subb a, #BS
      00008B 60 0E            [24]  124     jz rx_backspace
                                    125 
                                    126     ; Check for DEL (0x7F)
      00008D E8               [12]  127     mov a, r0
      00008E C3               [12]  128     clr c
      00008F 94 7F            [12]  129     subb a, #DEL
      000091 60 08            [24]  130     jz rx_backspace
                                    131 
                                    132     ; --- Normal Character Processing ---
      000093 E8               [12]  133     mov a, r0
      000094 F0               [24]  134     movx @dptr, a                ; Store in RAM buffer
      000095 A3               [24]  135     inc dptr                     ; Move buffer pointer forward
                                    136     
      000096 E8               [12]  137     mov a, r0                    ; Echo char back to terminal
      000097 00 45            [12]  138     acall uart_tx_char          
      000099 80 DE            [24]  139     sjmp uart_rx_loop
                                    140 
      00009B                        141 rx_backspace:
                                    142     ; --- Underflow Check ---
                                    143     
                                    144     ; 1. Check High Byte
      00009B A8 81            [24]  145     mov r0, sp                   ; R0 points to top of stack (saved DPH)
      00009D E6               [12]  146     mov a, @r0                   ; A = saved DPH
      00009E C3               [12]  147     clr c
      00009F 95 83            [12]  148     subb a, dph                  ; Compare saved DPH with current DPH
      0000A1 70 0C            [24]  149     jnz do_backspace             ; If difference != 0, they don't match -> safe to delete
                                    150 
                                    151     ; 2. Check Low Byte
      0000A3 E5 81            [12]  152     mov a, sp
      0000A5 14               [12]  153     dec a                        ; Target SP - 1 (saved DPL)
      0000A6 F8               [12]  154     mov r0, a                    ; R0 points to saved DPL
      0000A7 E6               [12]  155     mov a, @r0                   ; A = saved DPL
      0000A8 C3               [12]  156     clr c
      0000A9 95 82            [12]  157     subb a, dpl                  ; Compare saved DPL with current DPL
      0000AB 70 02            [24]  158     jnz do_backspace             ; If difference != 0, they don't match -> safe to delete
                                    159 
                                    160     ; If both match exactly, buffer is empty. Ignore backspace.
      0000AD 80 CA            [24]  161     sjmp uart_rx_loop
                                    162 
      0000AF                        163 do_backspace:
                                    164     ; Decrement the 16-bit DPTR (8051 has no DEC DPTR, must do manually)
      0000AF E5 82            [12]  165     mov a, dpl
      0000B1 14               [12]  166     dec a
      0000B2 F5 82            [12]  167     mov dpl, a
ASxxxx Assembler V02.00 + NoICE + SDCC mods  (Intel 8051)               Page 6
Hexadecimal [24-Bits]



      0000B4 B4 FF 02         [24]  168     cjne a, #0xFF, skip_dph_dec  ; If low byte rolled over from 00 to FF
      0000B7 15 83            [12]  169     dec dph                      ; Decrement the high byte
      0000B9                        170 skip_dph_dec:
                                    171 
                                    172     ; Visual erasure on user terminal (BS, Space, BS)
      0000B9 74 08            [12]  173     mov a, #BS
      0000BB 00 45            [12]  174     acall uart_tx_char
      0000BD 74 20            [12]  175     mov a, #SPC
      0000BF 00 45            [12]  176     acall uart_tx_char
      0000C1 74 08            [12]  177     mov a, #BS
      0000C3 00 45            [12]  178     acall uart_tx_char
      0000C5 80 B2            [24]  179     sjmp uart_rx_loop
                                    180 
      0000C7                        181 rx_terminate:
                                    182     ; Terminate string with NULL
      0000C7 74 00            [12]  183     mov a, #NULL
      0000C9 F0               [24]  184     movx @dptr, a
                                    185     
                                    186     ; Echo a newline to terminal
      0000CA 74 0A            [12]  187     mov a, #CR
      0000CC 00 45            [12]  188     acall uart_tx_char
      0000CE 74 0D            [12]  189     mov a, #LF
      0000D0 00 45            [12]  190     acall uart_tx_char
                                    191 
                                    192     ; 3. Clean up stack before exit
      0000D2 D0 83            [24]  193     pop dph                      ; Discard saved high byte
      0000D4 D0 82            [24]  194     pop dpl                      ; Discard saved low byte
      0000D6 22               [24]  195     ret
