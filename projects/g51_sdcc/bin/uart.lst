      000000                          6 uart_init:
      000000 53 89 0F         [24]    7     anl tmod, #0x0f                 ; Clear Timer 1 mode bits
      000003 43 89 20         [24]    8     orl tmod, #0x20                 ; Set Timer 1 to Mode 2 (8-bit auto-reload)
                                      9     
      000006 75 8D FF         [24]   10     mov th1, #0xff                  ; 57600 bps at 11.0592 MHz
                                     11     
      000009 43 87 80         [24]   12     orl pcon, #0x80                 ; Set SMOD to 1 (Doubles the baud rate generation)
                                     13     
      00000C 75 98 50         [24]   14     mov scon, #0x50                 ; Mode 1 (8-bit UART), ENABLE receiver (REN=1)
      00000F D2 8E            [12]   15     setb tr1                        ; Start Timer 1
                                     16     
                                     17     ;setb ti                         ; set transmitter 'ready'
                                     18 
      000011 74 00            [12]   19 	mov a, #0x00
      000013 90 01 00         [24]   20 	mov dptr, #uart_rx_buffer_head
      000016 F0               [24]   21 	movx @dptr, a
      000017 90 01 01         [24]   22 	mov dptr,#uart_rx_buffer_tail
      00001A F0               [24]   23 	movx @dptr, a
                                     24 
      00001B 22               [24]   25     ret
                                     26 
                                     27 ;uart_rx_char:
                                     28 ;	jnb ri, uart_rx_char			; wait for character to arrive
                                     29 ;	clr ri							; clear receiveer
                                     30 ;	mov a, sbuf						; get character
                                     31 ;	ret
                                     32 
      00001C                         33 uart_rx_char:
                                     34 	; if buffer is not empty, process char
      00001C 90 01 00         [24]   35 	mov dptr, #uart_rx_buffer_head
      00001F E0               [24]   36 	movx a, @dptr
      000020 F5 F0            [12]   37 	mov b, a
      000022                         38 uart_rx_wait_loop:
      000022 90 01 01         [24]   39 	mov dptr, #uart_rx_buffer_tail
      000025 E0               [24]   40 	movx a, @dptr
      000026 B5 F0 02         [24]   41 	cjne a, b, uart_rx_process_char
      000029 80 F7            [24]   42 	sjmp uart_rx_wait_loop					; otherwise loop back and wait for char
      00002B                         43 uart_rx_process_char:
                                     44 	; process char, store in a
      00002B 90 00 00         [24]   45 	mov dptr, #uart_rx_buffer
      00002E E5 F0            [12]   46 	mov a, b							; restore buffer head
      000030 25 82            [12]   47 	add a, dpl							; add head to buffer
      000032 50 02            [24]   48 	jnc uart_rx_char_skip_dph
      000034 05 83            [12]   49 	inc dph
      000036                         50 uart_rx_char_skip_dph:
      000036 F5 82            [12]   51 	mov dpl, a							; dptr contains address of char at buffer + head
      000038 E0               [24]   52 	movx a, @dptr						; retrieve character from buffer
      000039 C0 E0            [24]   53 	push acc							; save char
                                     54 	; advance buffer head
      00003B E5 F0            [12]   55 	mov a, b							; b still contains buffer head
      00003D 04               [12]   56 	inc a
      00003E 90 01 00         [24]   57 	mov dptr, #uart_rx_buffer_head
