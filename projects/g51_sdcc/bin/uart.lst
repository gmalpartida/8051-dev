      00006E                         96 uart_rx_asciz:
      00006E AF 83            [24]   97 	mov R7, dph
      000070 AE 82            [24]   98 	mov R6, dpl									; save start of buffer for empty check later
      000072                         99 uart_rx_asciz_loop:
      000072 12 00 1F         [24]  100 	lcall uart_rx_char
      000075 F5 F0            [12]  101 	mov b, a									; make copy of it, next statements destroy char in a
      000077 60 47            [24]  102 	jz uart_rx_asciz_exit						; if NULL then exit
      000079 64 0D            [12]  103 	xrl a, #0x0d
      00007B 60 43            [24]  104 	jz uart_rx_asciz_exit						; if CR then exit
      00007D E5 F0            [12]  105 	mov a, b									; restore copy of char
      00007F 64 0A            [12]  106 	xrl a, #0x0a
      000081 60 3D            [24]  107 	jz uart_rx_asciz_exit						; if LF then exit
      000083 E5 F0            [12]  108 	mov a, b
      000085 64 08            [12]  109 	xrl a, #BS									; check for BS
      000087 70 02            [24]  110 	jnz uart_rx_asciz_process_del
      000089 80 06            [24]  111 	sjmp uart_rx_asciz_process_del_or_bs
      00008B                        112 uart_rx_asciz_process_del:
      00008B E5 F0            [12]  113 	mov a, b
