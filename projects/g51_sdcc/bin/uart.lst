      000041 F0               [24]   58 	movx @dptr, a		
      000042 D0 E0            [24]   59 	pop acc							; restore retrieved char
      000044 22               [24]   60 	ret
                                     61 
      000045                         62 uart_tx_char:
      000045 C2 99            [12]   63 	clr ti
      000047 F5 99            [12]   64 	mov sbuf, a
      000049                         65 wait_for_tx_done:
      000049 30 99 FD         [24]   66 	jnb ti, wait_for_tx_done
      00004C C2 99            [12]   67 	clr ti
      00004E 22               [24]   68 	ret
