      0000D7                        197 uart_rx_isr:
      0000D7 C0 E0            [24]  198 	push a
      0000D9 C0 F0            [24]  199 	push b
      0000DB C0 D0            [24]  200 	push psw
      0000DD C0 82            [24]  201 	push dpl
      0000DF C0 83            [24]  202 	push dph
      0000E1 E8               [12]  203 	mov a, r0
      0000E2 C0 E0            [24]  204 	push a
      0000E4 30 98 1F         [24]  205 	jnb ri, uart_rx_isr_exit
      0000E7 10 99 1C         [24]  206 	jbc ti, uart_rx_isr_exit
      0000EA C2 98            [12]  207 	clr ri
      0000EC E5 99            [12]  208 	mov a, sbuf							; retrieve received character
                                    209 	;mov sbuf, a
      0000EE F5 F0            [12]  210 	mov b, a							; save it for later
      0000F0 90 01 01         [24]  211 	mov dptr, #uart_rx_buffer_tail
      0000F3 E0               [24]  212 	movx a, @dptr						; get tail position
      0000F4 F8               [12]  213 	mov r0, a							; save buffer tail value
      0000F5 04               [12]  214 	inc a								; increment current buffer tail value
      0000F6 F0               [24]  215 	movx @dptr, a						; save it back
      0000F7 90 00 00         [24]  216 	mov dptr, #uart_rx_buffer			; get address of rx buffer
      0000FA E8               [12]  217 	mov a, r0							; restore buffer tail value
      0000FB 25 82            [12]  218 	add a, dpl								; add buffer tail value to buffer address
      0000FD 50 02            [24]  219 	jnc uart_rx_isr_skip_dph
      0000FF 05 83            [12]  220 	inc dph
      000101                        221 uart_rx_isr_skip_dph:
      000101 F5 82            [12]  222 	mov dpl, a
