      000067 12 00 50         [24]   90 	lcall uart_tx_char
      00006A A3               [24]   91 	inc dptr
      00006B 80 F7            [24]   92 	sjmp uart_tx_asciz_xram
      00006D                         93 uart_tx_asciz_xram_exit:
      00006D 22               [24]   94 	ret
