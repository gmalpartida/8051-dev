                                     30 ;uart_rx_char:
                                     31 ;	jnb ri, uart_rx_char			; wait for character to arrive
                                     32 ;	clr ri							; clear receiveer
                                     33 ;	mov a, sbuf						; get character
                                     34 ;	ret
                                     35 
      00001F                         36 uart_rx_char:
      00001F C0 82            [24]   37 	push dpl
      000021 C0 83            [24]   38 	push dph
                                     39 	; if buffer is not empty, process char
      000023 90 01 00         [24]   40 	mov dptr, #uart_rx_buffer_head
      000026 E0               [24]   41 	movx a, @dptr
      000027 F5 F0            [12]   42 	mov b, a							; save buffer head for later use
      000029                         43 uart_rx_wait_loop:
      000029 90 01 01         [24]   44 	mov dptr, #uart_rx_buffer_tail
      00002C E0               [24]   45 	movx a, @dptr						; read value of buffer tail
      00002D B5 F0 02         [24]   46 	cjne a, b, uart_rx_process_char		; compare to buffer head, it not same then there is a char
      000030 80 F7            [24]   47 	sjmp uart_rx_wait_loop				; otherwise loop back and wait for char
      000032                         48 uart_rx_process_char:
                                     49 	; process char, store in a
      000032 90 00 00         [24]   50 	mov dptr, #uart_rx_buffer
      000035 E5 F0            [12]   51 	mov a, b							; restore buffer head
      000037 25 82            [12]   52 	add a, dpl							; add head to buffer
      000039 50 02            [24]   53 	jnc uart_rx_char_skip_dph
      00003B 05 83            [12]   54 	inc dph
      00003D                         55 uart_rx_char_skip_dph:
      00003D F5 82            [12]   56 	mov dpl, a							; dptr contains address of char at buffer + head
      00003F E0               [24]   57 	movx a, @dptr						; retrieve character from buffer
      000040 C0 E0            [24]   58 	push acc							; save char
