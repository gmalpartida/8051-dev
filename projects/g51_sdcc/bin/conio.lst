                                      5 
                                      6 .area cseg (CODE)
                                      7 
      000000                          8 get_hex_address:
      000000 E6               [12]    9 	mov a, @r0
      000001 12 00 00         [24]   10 	lcall asc2nibble
      000004 08               [12]   11 	inc r0
      000005 F5 F0            [12]   12 	mov b, a
      000007 E6               [12]   13 	mov a, @r0
      000008 12 00 00         [24]   14 	lcall asc2nibble
      00000B C4               [12]   15 	swap a
      00000C 54 F0            [12]   16 	anl a, #0xf0
      00000E 45 F0            [12]   17 	orl a, b
      000010 C4               [12]   18 	swap a
      000011 22               [24]   19 	ret
                                     20 
      000012                         21 skip_blanks:
      000012 E0               [24]   22 	movx a, @dptr
      000013 60 06            [24]   23 	jz skip_blanks_exit
      000015 B4 20 03         [24]   24 	cjne a, #' ', skip_blanks_exit
      000018 A3               [24]   25 	inc dptr
      000019 80 F7            [24]   26 	sjmp skip_blanks
      00001B                         27 skip_blanks_exit:
      00001B 22               [24]   28 	ret
                                     29 
      00001C                         30 println:
      00001C 74 0A            [12]   31 	mov a, #CR
      00001E 12 00 00         [24]   32 	lcall uart_tx_char
      000021 74 0D            [12]   33 	mov a, #LF
      000023 12 00 00         [24]   34 	lcall uart_tx_char
      000026 22               [24]   35 	ret
                                     36 
                                     37 ; prints tab(s)
      000027                         38 printtab:
      000027 74 09            [12]   39 	mov a, #TAB
      000029 12 00 00         [24]   40 	lcall uart_tx_char
      00002C 22               [24]   41 	ret
                                     42 
                                     43 ; prints space(s)
      00002D                         44 printspc:
      00002D 74 20            [12]   45 	mov a, #' '
      00002F 12 00 00         [24]   46 	lcall uart_tx_char
      000032 22               [24]   47 	ret
                                     48 
