                                      5 .include "string.inc"
                                      1 ; finds character c in the first n bytes of a memory buffer in program memory
                                      2 ; --> r6,r7: address of memory buffer
                                      3 ; --> r5: 	character for which to search
                                      4 ; --> r4:	how many bytes at which to look
                                      5 ; <-- r6,r7: address at which character was found, otherwise NULL
                                      6 ; <-- c: clear if found, otherwise set
                                      7 .globl memchr_c
                                      8 
                                      9 ; finds character c in the first n bytes of a memory buffer in data memory
                                     10 ; --> r6,r7: address of memory buffer
                                     11 ; --> r5: 	character for which to search
                                     12 ; --> r4:	how many bytes at which to look
                                     13 ; <-- r6,r7: address at which character was found, otherwise NULL
                                     14 .globl memchr
                                     15 
                                     16 ; compares the first n bytes of two blocks of memory, one of which is in program memory
                                     17 ; --> r6, r7: 	address of block of memory in program memory
                                     18 ; --> r4, r5: 	address of block of memory in data memory
                                     19 ; --> r3: 		how many bytes to compare
                                     20 ; <-- r7:		0 if equal, -1 if first block is less than second block, otherwise 1
                                     21 
                                     22 .globl memcmp_c
                                     23 
                                     24 ; copies n bytes from one memory block to another, one of which resides in program memory
                                     25 ; --> r6, r7: address of source memory block in program memory
                                     26 ; --> r4, r5: address of destination memory block in data memory
                                     27 ; --> r3: 	  how many bytes to copy
                                     28 
                                     29 .globl memcpy_c
                                     30 
                                     31 ; initializes a memory block with a specific byte
                                     32 ; --> r6, r7: address of memory block
                                     33 ; --> r5: length of memory block
                                     34 ; --> r4: byte to fill the block
                                     35 
                                     36 .globl memset
                                     37 
                                     38 ; moves a memory block from one location to another
                                     39 ; --> r6, r7: address of source memory block
                                     40 ; --> r4, r5: address of destination memory block
                                     41 ; --> r3: how many bytes to move
                                     42 .globl memcpy
                                     43 
                                     44 .globl strncmp
                                     45 
                                     46 .globl strcmp
                                     47 
