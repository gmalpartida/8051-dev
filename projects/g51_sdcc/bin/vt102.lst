ASxxxx Assembler V02.00 + NoICE + SDCC mods  (Intel 8051)               Page 1
Hexadecimal [24-Bits]



                                      1 .include "vt102.inc"
                           00001B     1 VT102_ESC			.equ		0x1b
                                      2 
                                      3 .globl	VT102_CLEAR_SCREEN
                                      4 
                                      5 ; draws a line from the current position to a destination
                                      6 ; --> r7: row of end of line
                                      7 ; --> r6: col of end of line
                                      8 .globl vt102_line_to
ASxxxx Assembler V02.00 + NoICE + SDCC mods  (Intel 8051)               Page 2
Hexadecimal [24-Bits]



                                      2 
                                      3 .area cseg (CODE)
                                      4 
                                      5 ; draws a line from the current position to a destination
                                      6 ; --> r7: row of end of line
                                      7 ; --> r6: col of end of line
      000000                          8 vt102_line_to:
                                      9 	
                                     10 
      000000 22               [24]   11 	ret
                                     12 
      000001 1B 5B 41 00             13 VT102_UP:			.db		VT102_ESC, '[', 'A', 0
      000005 1B 5B 42 00             14 VT102_DOWN:			.db		VT102_ESC, '[', 'B', 0
      000009 1B 5B 43 00             15 VT102_RIGHT:		.db		VT102_ESC, '[', 'C', 0
      00000D 1B 5B 44 00             16 VT102_LEFT:			.db		VT102_ESC, '[', 'D', 0
      000011 1B 5B 48 1B 5B 32 4A    17 VT102_CLEAR_SCREEN:	.db		VT102_ESC, '[', 'H', VT102_ESC, '[', '2', 'J', 0
             00
