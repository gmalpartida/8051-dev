ASxxxx Assembler V02.00 + NoICE + SDCC mods  (Intel 8051)               Page 1
Hexadecimal [24-Bits]



                                      1 .include "ascii.inc"
                                      1 ; Function: asc2bin
                                      2 ; Input:  Accumulator (A) = ASCII character ('0'-'9', 'A'-'F')
                                      3 ; Output: Accumulator (A) = Binary value (00h-0Fh)
                                      4 ; Uses:   R0 (temporary storage)
                                      5 .globl asc2nibble
                                      6 
                                      7 ; converts a binary value to an ascii character
                                      8 ; --> a: binary value to be converted
                                      9 ; <-- a: ascii character 
                                     10 .globl nibble2asc
                                     11 
                                     12 ; converts a hex value to ascii
                                     13 ; --> a: hex value
                                     14 ; <-- b: ascii equivalent of upper nibble
                                     15 ; <-- a: ascii equivalent of lower nibble
                                     16 .globl hex2asc
ASxxxx Assembler V02.00 + NoICE + SDCC mods  (Intel 8051)               Page 2
Hexadecimal [24-Bits]



                                      2 
                                      3 .area CSEG (CODE)
                                      4 
                                      5 ; Function: asc2bin
                                      6 ; Input:  Accumulator (A) = ASCII character ('0'-'9', 'A'-'F')
                                      7 ; Output: Accumulator (A) = Binary value (00h-0Fh)
                                      8 ; Uses:   R0 (temporary storage)
                                      9 
      000000                         10 asc2nibble:
      000000 FA               [12]   11     MOV R2, A         	; Store original character in R2
      000001 C3               [12]   12     CLR C             	; Clear carry for subtraction
      000002 94 30            [12]   13     SUBB A, #0x30      	; Subtract 30h to handle '0'-'9'
                                     14     
                                     15     ; Check if result is > 9 (indicating it was likely 'A'-'F')
      000004 F9               [12]   16     MOV R1, A         	; Temporary copy of intermediate result
      000005 C3               [12]   17     CLR C
      000006 94 0A            [12]   18     SUBB A, #0x0A      	; Subtract 10 (0Ah)
      000008 50 02            [24]   19     JNC IS_ALPHA      	; If no borrow (A >= 10), it's 'A'-'F'
                                     20     
                                     21     ; It's a digit '0'-'9'
      00000A E9               [12]   22     MOV A, R1         	; Restore the '0'-'9' result
      00000B 22               [24]   23     RET
                                     24 
      00000C                         25 IS_ALPHA:
                                     26     ; It's a letter 'A'-'F'
      00000C EA               [12]   27     MOV A, R2         	; Start again with original ASCII char
      00000D 54 DF            [12]   28 	anl a, #0b11011111	; convert to uppercase
      00000F 94 37            [12]   29     SUBB A, #0x37      	; Subtract 37h to get binary 10-15
      000011 22               [24]   30     RET
                                     31 
                                     32 ; converts a binary value to an ascii character
                                     33 ; --> a: binary value to be converted
                                     34 ; <-- a: ascii character 
      000012                         35 nibble2asc:
      000012 C3               [12]   36 	clr c
      000013 FA               [12]   37 	mov r2, a
      000014 94 0A            [12]   38 	subb a, #0x0a
      000016 40 06            [24]   39 	jc nibble2asc_is_digit
      000018 EA               [12]   40 	mov a, r2
      000019 24 37            [12]   41 	add a, #0x37
      00001B 44 20            [12]   42 	orl a, #0b00100000	; convert to lowercase
      00001D 22               [24]   43 	ret
      00001E                         44 nibble2asc_is_digit:
      00001E EA               [12]   45 	mov a, r2
      00001F 24 30            [12]   46 	add a, #0x30
      000021 22               [24]   47 	ret
                                     48 
                                     49 ; converts a hex value to ascii
                                     50 ; --> a: hex value
                                     51 ; <-- b: ascii equivalent of upper nibble
                                     52 ; <-- a: ascii equivalent of lower nibble
      000022                         53 hex2asc:
      000022 FF               [12]   54 	mov r7, a
      000023 C4               [12]   55 	swap a
      000024 54 0F            [12]   56 	anl a, #0x0f
ASxxxx Assembler V02.00 + NoICE + SDCC mods  (Intel 8051)               Page 3
Hexadecimal [24-Bits]



      000026 12 00 12         [24]   57 	lcall nibble2asc
      000029 F5 F0            [12]   58 	mov b, a
      00002B EF               [12]   59 	mov a, r7
      00002C 54 0F            [12]   60 	anl a, #0x0f
      00002E 12 00 12         [24]   61 	lcall nibble2asc
      000031 22               [24]   62 	ret
                                     63 
